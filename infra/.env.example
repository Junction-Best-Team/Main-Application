# Provisioning credential in your shell, or GitHub deployment secret. Never pass to app pods.
DIGITALOCEAN_TOKEN=
# No cloud token is needed by infra/kubernetes: it uses a private kubeconfig.
# GitHub repository variables (not application environment):
# DIGITALOCEAN_CLUSTER_ID=<terraform cluster_id output>
# DEPLOY_ENABLED=true only after one-time setup/import; unset means build images only.
# DEPLOY_NAMESPACE=junction (optional; default junction)
