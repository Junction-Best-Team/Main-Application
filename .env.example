# Local demo only. `uv run aimo configure` fills private values without printing them.
DATABASE_URL=postgresql://aimo:aimo@localhost:55432/aimo
# Release schema-owner credentials belong only in the Kubernetes aimo-migration Secret.
# RUNTIME_DATABASE_USER is supplied there; never add an owner URL to API/worker env.
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
# Hosted: set only the trusted ingress proxy IPs/CIDRs. Never trust arbitrary public peers.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
PUBLIC_BASE_URL=http://localhost:8000
APPROVAL_SESSION_SECRET=
# False only for localhost HTTP. Hosted deployments MUST use true with HTTPS.
SECURE_COOKIES=false
# true serves /docs and /openapi.json (local development only; a hosted API never publishes them)
API_DOCS_ENABLED=false
DEMO_BUYER_PASSWORD=
# auto = live when VALIO_AIMO_API_KEY is set, else labelled invented fixtures. live = live only
# (fails closed without a key). fixture = invented fixtures only.
# The key exists; teammates have it. Never commit it.
UPSTREAM_MODE=auto
VALIO_AIMO_BASE_URL=https://junction26.valioaimo.fi
VALIO_AIMO_API_KEY=
# Product ids per supplier price/availability request (1 to 1000, default 100).
SUPPLIER_LOOKUP_BATCH_SIZE=100
# Google is shared by product and recipe ingestion/querying. Reindex before cutover.
# Use fixture for fast transaction tests. Legacy backends require explicit selection.
EMBEDDING_BACKEND=google
# These two fields apply only to the legacy sentence_transformers backend.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Blank uses the pin shared with the image build in src/aimo/model_spec.py.
EMBEDDING_MODEL_REVISION=
# Opt-in hosted search: first migrate and import a new catalog; see docs/hosted-search.md.
# EMBEDDING_BACKEND=openrouter selects Qwen3 Embedding 8B (4096 dimensions).
# Separate from LLM_API_KEY; configure privately, never in frontend environment variables.
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_ATTEMPTS=2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKERS=4
# Google hybrid searches use Gemini Decision 1 to rank the filtered shortlist.
RERANK_ENABLED=true
RERANK_CANDIDATES=30
# Product rows retained for active + previous generation; proposal snapshots are independent.
CATALOG_GENERATIONS_TO_KEEP=2
# `aimo sync-catalog` / `aimo ingest --download` supplier download bounds (docs/catalog-sync.md).
CATALOG_DOWNLOAD_TIMEOUT_SECONDS=60
CATALOG_DOWNLOAD_DEADLINE_SECONDS=900
CATALOG_DOWNLOAD_MAX_BYTES=268435456
CATALOG_DOWNLOAD_ATTEMPTS=3
# Blank uses the system temporary directory for the transient snapshot download.
CATALOG_WORK_DIR=
# Release migration Secret only: the dedicated catalog-sync role receiving catalog-only grants.
# CATALOG_SYNC_DATABASE_USER=
PROPOSAL_TTL_SECONDS=900
# Days after a proposal expired before `aimo purge-proposals` may remove it (never ordered ones only).
# That command is run by hand with the schema owner's DATABASE_URL, not by the app or the runtime role.
UNFINISHED_PROPOSAL_RETENTION_DAYS=30

# Shared native Google credential for chat, guardrails, search and image generation.
# Server-side only. See docs/google-models.md for existing-index cutover.
GEMINI_API_KEY=
# Voice uses the same server-side key in the API to mint single-use Live tokens.
VOICE_ENABLED=true
VOICE_MODEL=gemini-3.8-live
CLOUDINARY_URL=
# Optional recipe illustration tool; needs both credentials above (docs/recipe-images.md).
RECIPE_IMAGES_ENABLED=true
RECIPE_IMAGE_MODEL=gemini-nano-banana-2.1
RECIPE_IMAGE_TIMEOUT_SECONDS=45
RECIPE_IMAGE_HOURLY_LIMIT=5

# Server-side conversational provider; never exposed through Vite/browser configuration.
LLM_PROVIDER=google
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gemini-4-carbon
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
# Low thinking effort keeps the chat responsive. Blank omits the override.
LLM_REASONING_EFFORT=low
LLM_MAX_COMPLETION_TOKENS=8192
LLM_MAX_TOOL_ROUNDS=20

# Semantic guardrails use Gemini Decision 1 with GEMINI_API_KEY. Default enforce;
# shadow records verdicts only; off disables semantic checks. Purchasing controls always apply.
GUARDRAIL_PROVIDER=google
GUARDRAIL_MODE=enforce
# Standing orders (docs/scheduler.md). Runs start from this Helsinki hour on the scheduled date.
# SCHEDULER_RUN_AFTER_HOUR=6
# A date missed by a short outage runs late while now is at most this many hours after its run time.
# SCHEDULER_GRACE_HOURS=6
# DEMO ONLY: allow a first run date of today and a "Run now (demo)" button. Leave false in production.
# SCHEDULER_DEMO_MODE=false
