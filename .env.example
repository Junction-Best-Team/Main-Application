# Local demo only. `uv run aimo configure` fills private values without printing them.
DATABASE_URL=postgresql://aimo:aimo@localhost:55432/aimo
# Release schema-owner credentials belong only in the Kubernetes aimo-migration Secret.
# RUNTIME_DATABASE_USER is supplied there; never add an owner URL to API/worker env.
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
# Hosted: set only the trusted ingress proxy IPs/CIDRs. Never trust arbitrary public peers.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
PUBLIC_BASE_URL=http://localhost:8000
APPROVAL_SESSION_SECRET=
# False only for localhost HTTP. Hosted deployments MUST use true with HTTPS.
SECURE_COOKIES=false
DEMO_BUYER_PASSWORD=
# auto = live when VALIO_AIMO_API_KEY is set, else labelled invented fixtures. live = live only
# (fails closed without a key). fixture = invented fixtures only.
# The key exists; teammates have it. Never commit it.
UPSTREAM_MODE=auto
VALIO_AIMO_BASE_URL=https://junction26.valioaimo.fi
VALIO_AIMO_API_KEY=
# Use fixture for fast transaction tests; sentence_transformers for actual hybrid search.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Blank uses the pin shared with the image build in src/aimo/model_spec.py.
EMBEDDING_MODEL_REVISION=
# Opt-in hosted search: first migrate and import a new catalog; see docs/hosted-search.md.
# EMBEDDING_BACKEND=openrouter selects Qwen3 Embedding 8B (4096 dimensions).
# Separate from LLM_API_KEY; configure privately, never in frontend environment variables.
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_ATTEMPTS=2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKERS=4
# Reranking applies only to the openrouter backend's hybrid searches.
RERANK_ENABLED=true
RERANK_CANDIDATES=30
# Product rows retained for active + previous generation; proposal snapshots are independent.
CATALOG_GENERATIONS_TO_KEEP=2
PROPOSAL_TTL_SECONDS=900

# Server-side conversational provider; never exposed through Vite/browser configuration.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOOL_ROUNDS=20

# Enable only after migrations, recipe import and reviewed ingredient evidence.
RECIPE_PLANNING_ENABLED=false

# Semantic guardrails: TypeSafe Jev through OpenRouter's Decisions API (docs/guardrails.md).
# off = no classifier calls; shadow = record verdicts only; enforce = fail closed on new baskets.
# Deterministic purchasing controls and customer confirmation apply in every mode.
GUARDRAIL_MODE=shadow
# Blank reuses LLM_API_KEY only when LLM_BASE_URL and GUARDRAIL_BASE_URL are both openrouter.ai.
GUARDRAIL_API_KEY=
GUARDRAIL_BASE_URL=https://openrouter.ai/api/alpha
GUARDRAIL_MODEL=typesafe/jev-1.14
GUARDRAIL_TIMEOUT_SECONDS=5
GUARDRAIL_MAX_CALLS_PER_TURN=16
# Per-buyer chat bounds across conversations; accepted retries are not counted again.
CHAT_MAX_MESSAGES_PER_HOUR=60
CHAT_MAX_ACTIVE_TURNS=3
