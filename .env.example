# Environment variables. Copy to `.env` (gitignored) and fill in real values locally.
# Keep real values in local/deployment settings. Never put secrets here.

# API key for Valio Aimo's mock APIs (sent as the X-API-Key header). Get it from the challenge page.
AIMO_API_KEY=replace-me

# Base URL of the Valio Aimo mock API. Get it from the resource portal (https://junction26.valioaimo.fi/).
# This is the API host, not the webshop address. Never send the API key to the webshop host.
AIMO_API_BASE_URL=https://junction26.valioaimo.fi

# Test webshop (read-only checks of units, prices and labels). Test credentials come from the organisers.
# Never commit real values; agents must not print them.
AIMO_WEBSHOP_URL=https://example.invalid
AIMO_WEBSHOP_USERNAME=replace-me
AIMO_WEBSHOP_PASSWORD=replace-me
