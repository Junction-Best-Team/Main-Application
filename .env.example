# Planned configuration names only: application code is not implemented yet.
# Keep actual secrets in ignored local files or deployment secret settings.

# Upstream catalog download, price, and availability API.
VALIO_AIMO_BASE_URL=https://junction26.valioaimo.fi
VALIO_AIMO_API_KEY=

# PostgreSQL connection for derived search data, customer rules/authority,
# and new transaction records. Seed demo rules during setup, not on pod startup.
# Configure a PostgreSQL instance with the pgvector extension.
DATABASE_URL=

# Initial model candidate; evaluate it before pinning the exact revision.
# Ingestion and query embedding must use the same model and revision.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=

# Public HTTPS origin for the React inbox, browser API, MCP and approval URLs.
# Browser API calls use the same origin; set this value for each deployment.
PUBLIC_BASE_URL=

# Private session-signing secret for authenticated browser approval.
# Generate a real value in local/deployment secret settings; never commit it.
APPROVAL_SESSION_SECRET=

# Buyer and agent credential settings remain to be defined with the chosen
# seeded demo / existing identity implementation. The URL alone grants no access.
# Keep every secret above backend-only. Never copy it into VITE_* variables
# or frontend assets. Outbound notification settings are not needed for the MVP.
