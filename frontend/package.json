{
  "name": "aimo-purchasing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.6.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src e2e vite.config.ts playwright.config.ts --max-warnings 0",
    "format": "prettier --write src e2e docs README.md AGENTS.md *.ts eslint.config.js package.json",
    "format:check": "prettier --check src e2e docs README.md AGENTS.md *.ts eslint.config.js package.json",
    "typecheck": "tsc --noEmit",
    "types": "openapi-typescript openapi.json -o src/shared/api/schema.ts",
    "test": "playwright test",
    "test:ui": "playwright test e2e/chat.spec.ts",
    "test:integration": "AIMO_INTEGRATION=1 playwright test e2e/approval.spec.ts",
    "check": "npm run format:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "5.3.9",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
