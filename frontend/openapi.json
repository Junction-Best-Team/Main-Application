  "components": {
    "schemas": {
      "CommitRequest": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Proposal Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposal_id",
          "revision",
          "idempotency_key"
        ],
        "title": "CommitRequest"
      },
      "DecisionRequest": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InboxResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProposalResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "InboxResponse"
      },
      "LineRequest-Input": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Product Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "unit": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "title": "Unit",
            "description": "Explicit catalog unit code, L or KG; boxes is ambiguous."
          },
          "substitutes_for": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Substitutes For"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "amount",
          "unit"
        ],
        "title": "LineRequest"
      },
      "LineRequest-Output": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Product Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "unit": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "title": "Unit",
            "description": "Explicit catalog unit code, L or KG; boxes is ambiguous."
          },
          "substitutes_for": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Substitutes For"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "amount",
          "unit"
        ],
        "title": "LineRequest"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LookupRequest": {
        "properties": {
          "product_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Product Ids"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_ids",
          "delivery_date"
        ],
        "title": "LookupRequest"
      },
      "NextAction": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "commit",
              "wait",
              "revise_request",
              "request_fresh_proposal",
              "stop",
              "complete"
            ],
            "title": "Type"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "poll_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poll After Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "NextAction"
      },
      "ProposalResponse": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          },
          "policy_outcome": {
            "type": "string",
            "enum": [
              "ready_to_commit",
              "approval_required",
              "denied",
              "needs_resolution"
            ],
            "title": "Policy Outcome"
          },
          "approval_status": {
            "type": "string",
            "title": "Approval Status"
          },
          "order_status": {
            "type": "string",
            "title": "Order Status"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "next_action": {
            "$ref": "#/components/schemas/NextAction"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "approval_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Url"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "buyer_id": {
            "type": "string",
            "title": "Buyer Id"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "request": {
            "$ref": "#/components/schemas/PurchaseRequest-Output"
          },
          "snapshot": {
            "$ref": "#/components/schemas/PurchaseSnapshot"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History"
          },
          "can_decide": {
            "type": "boolean",
            "title": "Can Decide",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposal_id",
          "revision",
          "policy_version",
          "policy_outcome",
          "approval_status",
          "order_status",
          "reasons",
          "expires_at",
          "next_action",
          "buyer_id",
          "agent_id",
          "request",
          "snapshot"
        ],
        "title": "ProposalResponse"
      },
      "PurchaseRequest-Input": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Request Id"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/LineRequest-Input"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Lines"
          },
          "destination": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Destination"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
