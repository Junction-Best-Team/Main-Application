# The model can prepare; only the authenticated buyer can confirm.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 40
  }
}
direction: right
classes: {
  app: {
    style: {fill: "#EAF1FF"; stroke: "#6984AE"; border-radius: 12; font-size: 20}
  }
  human: {
    style: {fill: "#E2F5EF"; stroke: "#65A08D"; border-radius: 12; font-size: 20}
  }
  check: {
    style: {fill: "#FFF2D9"; stroke: "#B29963"; border-radius: 12; font-size: 20}
  }
}
# Read across the first row, back across the second, then across the third.
grid-rows: 3
grid-columns: 4
horizontal-gap: 70
vertical-gap: 85
message: "Buyer sends message\nReact chat interface" {class: human; width: 285; height: 145}
api: "API authenticates\nSession · Origin · CSRF" {class: app; width: 285; height: 145}
queue: "PostgreSQL saves turn\nMessage + durable queue" {class: app; width: 285; height: 145; shape: cylinder}
worker: "Worker claims turn\nLease + buyer-scoped identity" {class: app; width: 285; height: 145}
basket: "Save proposal revision\nExact basket + reasons" {class: app; width: 285; height: 145}
checks: "Purchasing checks\nScope · quantity · dietary\nPrice · stock · budget" {class: check; width: 285; height: 145}
tools: "Typed tool registry\nSearch · plan · prepare · read\nNo approve / commit tool" {class: app; width: 285; height: 145}
model: "Bounded model loop\nSaved context + instructions\nProposes typed tool calls" {class: app; width: 285; height: 145}
review: "Buyer reviews basket\nSaved chat + proposal via API" {class: human; width: 285; height: 145}
confirm: "Buyer clicks Confirm\nAuthenticated exact revision" {class: human; width: 285; height: 145}
recheck: "API revalidates\nFresh price / stock + authority" {class: check; width: 285; height: 145}
receipt: "Save mock order + receipt\nIdempotency + audit\nNo supplier checkout" {class: human; width: 285; height: 145}
message -> api -> queue -> worker -> model
model <-> tools
tools -> checks -> basket -> review -> confirm -> recheck -> receipt
