# Runtime flow. Blue boxes are separate workloads in the same Kubernetes cluster.
# The three green stores are logical areas of ONE external managed PostgreSQL database.
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 35}}
direction: down
classes: {
  app: {style: {fill: "#EAF1FF"; stroke: "#6984AE"; border-radius: 12; font-size: 22}}
  data: {style: {fill: "#E2F5EF"; stroke: "#65A08D"; font-size: 21}}
  external: {style: {fill: "#F1EAFF"; stroke: "#9B85BE"; border-radius: 12; font-size: 21}}
  ops: {style: {fill: "#FFF2D9"; stroke: "#B29963"; border-radius: 12; font-size: 20}}
}
browser: "BUYER WEB APP\nReact in the browser\nChat · basket · history" {class: data; style.border-radius: 12}
frontend: "FRONTEND SERVER\nNginx · Kubernetes pod\nServes React files" {class: app}
api: "APPLICATION API\nFastAPI · Kubernetes pod\nSessions · chat · confirmation" {class: app}
queue: "DURABLE CHAT QUEUE\nPostgreSQL conversation_turns\nQueued work + claim leases" {class: data; shape: cylinder}
worker: "AI WORKER\nIndependent Kubernetes pod\nPoll → claim → run agent" {class: app}
records: "APPLICATION RECORDS\nSame PostgreSQL database\nReplies · proposals · policies\nConfirmations · mock orders · audit" {class: data; shape: cylinder}
catalog: "CATALOG + VECTORS\nSame PostgreSQL / pgvector\nProducts · optional recipes" {class: data; shape: cylinder}
llm: "CONVERSATIONAL LLM\nOpenRouter default\nTool calls + replies" {class: external}
search: "HOSTED SEARCH / OPTIONAL\nQwen3 embeddings + reranker\nAlternative to local E5" {class: external; style.stroke-dash: 4}
supplier: "VALIO AIMO API\nPrices + availability only\nLabelled fixtures in demo mode" {class: external}
inputs: "PRIVATE DATASETS\nProducts · optional recipes" {class: ops; shape: page}
import: "OPERATOR JOBS\nExplicit import / schema setup\nRuns in Kubernetes" {class: ops}
browser -> frontend: "Load React files\nHTTPS via Traefik"
browser <-> api: "1. Send message / receive events\nHTTPS via Traefik"
api -> queue: "2. Save queued turn"
queue -> worker: "3. Worker polls + claims"
worker -> records: "4. Persist reply + proposal"
api <-> records: "5. Read saved updates\nSessions + purchases"
worker -> catalog: hybrid search
worker -> llm: model requests
worker -> search: embed / rerank {style.stroke-dash: 4}
worker -> supplier: shortlist lookup
api -> supplier: confirmation recheck
inputs -> import -> catalog: explicit batch import {style.stroke-dash: 4}
